# ==============================================================================
# Folks Multi-Agent Orchestrator - Environment Configuration Template
# Copy this file to .env and configure for your local or production deployment.
# ==============================================================================

# Database Connection
# SQLite (Local Development default):
DATABASE_URL=sqlite+aiosqlite:///./folks.db
# PostgreSQL (Production / Docker):
# DATABASE_URL=postgresql+asyncpg://folks:folks_password@localhost:5432/folks_db

# State Machine & Concurrency Lock Timing
LOCK_DEFAULT_TTL_SECONDS=60
LOCK_SWEEPER_INTERVAL_SECONDS=5
DAEMON_HEARTBEAT_INTERVAL_SECONDS=15

# Orchestrator Server Host & Port
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Universal Model Gateway (LiteLLM Proxy)
LITELLM_PROXY_URL=http://localhost:4000
LITELLM_API_KEY=sk-dummy-local-key

# Cockpit Frontend UI Configurations
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000
